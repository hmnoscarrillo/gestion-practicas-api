	"item": [
		{
			"name": "01 - Health & Verificacion",
			"item": [
				{
					"name": "01. GET - Verificar Estado de la API (Health Check)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('API esta operativa', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('UP');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						},
						"description": "Verifica que el servicio Express y el despliegue en Railway se encuentren en línea."
					},
					"response": []
				}
			]
		},
		{
			"name": "02 - Ciclo CRUD Tabla Central (sesiones_terapia)",
			"item": [
				{
					"name": "02. POST - Crear Nueva Sesion de Fisioterapia",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Sesion creada exitosamente con ID retornado', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property('id_sesion');",
									"    pm.collectionVariables.set('id_sesion_creada', jsonData.data.id_sesion);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigo_sesion\": \"SES-TEST-001\",\n  \"id_paciente\": 1,\n  \"id_fisioterapeuta\": 3,\n  \"id_servicio\": 2,\n  \"id_sede\": 1,\n  \"id_historia\": 1,\n  \"fecha_sesion\": \"2026-11-15\",\n  \"hora_inicio\": \"10:00:00\",\n  \"hora_fin\": \"10:45:00\",\n  \"numero_sesion\": 1,\n  \"escala_dolor_eva\": 7,\n  \"observaciones_evolucion\": \"Sesion inicial de prueba: evaluacion de movilidad articular lumbar\",\n  \"estado_sesion\": \"Programada\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/sesiones/createSesion",
							"host": ["{{base_url}}"],
							"path": ["api", "sesiones", "createSesion"]
						},
						"description": "Crea una nueva sesión clínica vinculando las 5 entidades relacionadas (Paciente, Fisioterapeuta, Servicio, Sede e Historia Clínica)."
					},
					"response": []
				},
				{
					"name": "03. GET - Listar Todas las Sesiones (con JOINs)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
