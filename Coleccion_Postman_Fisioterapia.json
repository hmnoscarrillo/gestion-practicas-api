									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Retorna arreglo con registros completos y relaciones', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"    pm.expect(jsonData.data.length).to.be.above(0);",
									"    pm.expect(jsonData.data[0]).to.have.property('paciente_nombre');",
									"    pm.expect(jsonData.data[0]).to.have.property('fisioterapeuta_nombre');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/sesiones/getSesiones",
							"host": ["{{base_url}}"],
							"path": ["api", "sesiones", "getSesiones"]
