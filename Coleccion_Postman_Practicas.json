    {
      "name": "2. CRUD Tabla Principal (practicas)",
      "description": "Pruebas sobre la entidad con mas relaciones (5 llaves foraneas: estudiante_id, empresa_id, programa_id, convenio_id, tutor_academico_id).",
      "item": [
        {
          "name": "READ 1: Listar todas las practicas",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Retorna lista con datos\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/practicas/getPracticas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "practicas", "getPracticas"]
            },
            "description": "Obtiene la lista completa de practicas profesionales con los datos cruzados mediante JOIN (estudiante, empresa, programa, convenio y tutor)."
          },
          "response": []
        },
        {
          "name": "READ 2: Consultar practica por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Detalle de practica contiene campos correctos\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.id).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/practicas/getPracticaById/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "practicas", "getPracticaById", "1"]
            },
            "description": "Lee el registro individual de la practica ID 1 con su detalle."
          },
          "response": []
        },
        {
          "name": "CREATE: Registrar nueva practica (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.idInsertado) {",
                  "    pm.collectionVariables.set(\"createdId\", json.data.idInsertado.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_practica\": \"PRAC-2026-TEST-99\",\n  \"estudiante_id\": 2,\n  \"empresa_id\": 3,\n  \"programa_id\": 2,\n  \"convenio_id\": 3,\n  \"tutor_academico_id\": 2,\n  \"cargo_practicante\": \"Practicante de Automatizacion y QA\",\n  \"fecha_inicio\": \"2026-08-01\",\n  \"fecha_fin\": \"2026-12-15\",\n  \"modalidad\": \"Hibrido\",\n  \"horas_totales\": 380,\n  \"estado\": \"En curso\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/practicas/postPractica",
              "host": ["{{baseUrl}}"],
              "path": ["api", "practicas", "postPractica"]
            },
            "description": "Crea una nueva practica profesional en la base de datos vinculando estudiante 2, empresa 3, programa 2, convenio 3 y tutor 2."
          },
          "response": []
        },
        {
          "name": "UPDATE: Actualizar practica (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Mensaje confirma actualizacion exitosa\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_practica\": \"PRAC-2026-TEST-99\",\n  \"estudiante_id\": 2,\n  \"empresa_id\": 3,\n  \"programa_id\": 2,\n  \"convenio_id\": 3,\n  \"tutor_academico_id\": 2,\n  \"cargo_practicante\": \"Ingeniero QA Junior en Automatizacion\",\n  \"fecha_inicio\": \"2026-08-01\",\n  \"fecha_fin\": \"2026-12-20\",\n  \"modalidad\": \"Remoto\",\n  \"horas_totales\": 400,\n  \"estado\": \"En curso\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/practicas/putPractica/{{createdId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "practicas", "putPractica", "{{createdId}}"]
            },
            "description": "Actualiza el cargo, la modalidad a 'Remoto' y las horas totales a 400 del registro recien creado."
          },
          "response": []
        },
        {
          "name": "DELETE: Eliminar practica",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Mensaje confirma eliminacion exitosa\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/practicas/deletePractica/{{createdId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "practicas", "deletePractica", "{{createdId}}"]
            },
            "description": "Elimina el registro de la practica que fue creada en la prueba previa."
          },
          "response": []
        },
        {
          "name": "VERIFY: Comprobar que ya no existe (404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Respuesta confirma recurso no encontrado\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/practicas/getPracticaById/{{createdId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "practicas", "getPracticaById", "{{createdId}}"]
            },
            "description": "Requisito de la Fase 3: Verifica despues con una lectura que el registro efectivamente ya no existe retornando 404."
          },
          "response": []
        }
      ]
    },
